-ExecCondition=/usr/libexec/qmmf-server/check-camx-overlay.sh
+ExecCondition=/usr/libexec/qmmf-server/wait-camx-overlay.sh 60
 ExecStart=/usr/bin/qti-cam-server
 
 [Install]
diff --git a/src/qmmf-server/wait-camx-overlay.sh b/src/qmmf-server/wait-camx-overlay.sh
new file mode 100755
index 0000000..9d2833d
--- /dev/null
+++ b/src/qmmf-server/wait-camx-overlay.sh
@@ -0,0 +1,32 @@
+#!/bin/sh
+
+# wait-camx-overlay.sh
+
+# Description:
+#   Wrapper around check-camx-overlay.sh, used as the ExecCondition of
+#   qti-cam-server.service. The camera driver module (camera_qcm6490) is loaded
+#   asynchronously by udev from the device tree, so on a cold boot the plain
+#   check can be evaluated before the /dev/video* nodes exist. A failing
+#   ExecCondition makes systemd skip the unit, and a skipped unit is never
+#   retried, which left qti-cam-server down until it was started by hand.
+
+# Behavior:
+#   - Polls check-camx-overlay.sh once per second.
+#   - Exits 0 as soon as it succeeds, so the unit starts.
+#   - Exits 1 after the timeout, so a system without a camera overlay is still
+#     skipped as intended.
+
+# Usage:
+#   wait-camx-overlay.sh [timeout-seconds]     # default 60
+
+timeout="${1:-60}"
+check=/usr/libexec/qmmf-server/check-camx-overlay.sh
+
+i=0
+while [ "$i" -lt "$timeout" ]; do
+    "$check" && exit 0
+    sleep 1
+    i=$((i + 1))
+done
+
+exit 1
